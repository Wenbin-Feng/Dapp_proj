NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=dapp
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=dapp
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional demo chain. Leave unset to retain the existing database product backend.
# Local development: run chain:deploy-tokens, then use its saved public manifest.
# DEMO_DEPLOYMENT_FILE=deployments/31337.json
# DEMO_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Sepolia: paste the reviewed manifest JSON into DEMO_DEPLOYMENT instead of FILE.
# DEMO_DEPLOYMENT=
# DEMO_RPC_URL=server-only RPC URL (optional; defaults to the public RPC)
PRODUCT_BACKEND=database
# Deployment scripts read shell variables; never put a private key in NEXT_PUBLIC_*.
# DEMO_CHAIN_ID=11155111
# DEMO_DEPLOYER_PRIVATE_KEY=
# DEMO_TREASURY=0x...
# DEMO_WALLETS=0x...,0x...,0x...,0x...,0x...
